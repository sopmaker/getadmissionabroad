generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  date      String
  slot      String
  createdAt DateTime @default(now())
}
